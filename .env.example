# Copie para .env.local e preencha. Nunca commite valores reais.

# Supabase (Project Settings → API). O schema "tarefas" precisa estar em "Exposed schemas" e "Allow public access" do Realtime desligado.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Somente para scripts (seed e teste de concorrência); o app não usa em runtime.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-servidor

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=
